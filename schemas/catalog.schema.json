{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/catalog.schema.json",
  "title": "Catalog product contract",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "basePrice",
    "image"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "basePrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "pizza",
        "bebida",
        "food",
        "drink",
        "dessert"
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "price",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "diameterCm": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "serves": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "available": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
